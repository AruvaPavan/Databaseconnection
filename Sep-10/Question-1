def validate_input(user_input):
    if not user_input.strip():
        print("Error:Input Cannot be empty")
        return None 
    
    values=user_input.split()

    if len(values)!=3:
        print("Error:Each entry contains exactly 3 values Id Name Age")
    id_value=values[0]
    name_value=values[1]
    age_value=values[2]

    try:
        student_id=int(id_value)
    except ValueError:
        print("Error:ID must be an integer")
        return None 

    if student_id<=0:
        print("Error:Id must be greater than 0")
        return None 

    if name_value == "":
        print("Error: Name cannot be empty.")
        return None

    if not any(character.isalpha() for character in name_value):
        print("Error: Name cannot contain only numbers.")
        return None

    try:
        age_value = float(age_value)
    except ValueError:
        print("Error: Age must be a valid floating-point number.")
        return None
    
    if age_value < 0:
        print("Error: Age cannot be negative.")
        return None
    return [student_id, name_value, age_value]


def check_user(IdsList):

    placeholders = ", ".join(["%s"] * len(IdsList))

    query = f"""
    SELECT id
    FROM students
    WHERE id IN ({placeholders})
    """

    cursor.execute(query, IdsList)

    result = cursor.fetchall()

    existing_ids = [row[0] for row in result]

    return existing_ids

def add_users(list1, list2, list3):

